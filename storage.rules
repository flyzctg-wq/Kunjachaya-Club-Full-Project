rules_version = '2';

// Firebase Storage Security Rules for Kunjachaya Club
service firebase.storage {
  match /b/{bucket}/o {
    
    // User Profile Pictures: profile_pics/{userId}
    match /profile_pics/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Complaints evidence images & files
    match /complaints/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback: allow read/write for authenticated users
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
